{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ato.local/schemas/ssp-profile-baselines.schema.json",
  "title": "SSP workspace resolved baseline selections",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "low", "moderate", "high"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "low": {
      "$ref": "#/$defs/controlIds"
    },
    "moderate": {
      "$ref": "#/$defs/controlIds"
    },
    "high": {
      "$ref": "#/$defs/controlIds"
    }
  },
  "$defs": {
    "controlIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,3}-\\d+(?:\\([0-9]+\\)|(?:\\.[0-9]+)+)?$"
      }
    }
  }
}
